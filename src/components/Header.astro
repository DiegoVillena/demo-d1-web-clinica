---
import Icono from "./Icono.astro";
import { NAV, SITE } from "../data/site";

const ruta = Astro.url.pathname;

const esActiva = (href: string) =>
  href === "/" ? ruta === "/" : ruta.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 text-slate-900" aria-label="Dental Serrano — Inicio">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-teal-700 text-white">
        <Icono nombre="logotipo" class="h-5 w-5" />
      </span>
      <span class="leading-tight">
        <span class="block text-[15px] font-bold">Dental Serrano</span>
        <span class="block text-[11px] font-medium tracking-wide text-teal-700 uppercase">Clínica dental · Albacete</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Navegación principal">
      {
        NAV.map(({ href, texto }) => (
          <a
            href={href}
            aria-current={esActiva(href) ? "page" : undefined}
            class={`text-sm font-medium transition-colors ${
              esActiva(href) ? "text-teal-700" : "text-slate-600 hover:text-slate-900"
            }`}
          >
            {texto}
          </a>
        ))
      }
      <a
        href="/contacto/"
        class="rounded-full bg-teal-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-teal-800">
        Pedir cita
      </a>
    </nav>

    <button
      id="btn-menu"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full text-slate-700 hover:bg-slate-100 md:hidden"
      aria-expanded="false"
      aria-controls="menu-movil"
      aria-label="Abrir el menú"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-6 w-6" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div id="menu-movil" class="hidden border-t border-slate-100 bg-white md:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3" aria-label="Navegación móvil">
      {
        NAV.map(({ href, texto }) => (
          <a
            href={href}
            aria-current={esActiva(href) ? "page" : undefined}
            class={`rounded-lg px-3 py-2.5 text-[15px] font-medium ${
              esActiva(href) ? "bg-teal-50 text-teal-700" : "text-slate-700 hover:bg-slate-50"
            }`}
          >
            {texto}
          </a>
        ))
      }
      <a href="/contacto/" class="mt-2 rounded-full bg-teal-700 px-5 py-3 text-center text-sm font-semibold text-white hover:bg-teal-800">
        Pedir cita
      </a>
    </nav>
  </div>
</header>

<script>
  const btnMenu = document.getElementById("btn-menu");
  const menuMovil = document.getElementById("menu-movil");

  if (btnMenu && menuMovil) {
    btnMenu.addEventListener("click", () => {
      const oculto = menuMovil.classList.toggle("hidden");
      btnMenu.setAttribute("aria-expanded", String(!oculto));
      btnMenu.setAttribute("aria-label", oculto ? "Abrir el menú" : "Cerrar el menú");
    });
  }
</script>