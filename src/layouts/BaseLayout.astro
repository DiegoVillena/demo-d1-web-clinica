---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, HORARIO_JSONLD } from "../data/site";

interface Props {
  /** Título ÚNICO de la página (ya incluye la marca). */
  title: string;
  /** Metadescripción única (~150 caracteres). */
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const imagen = `${SITE.url}${SITE.ogImage}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  name: SITE.name,
  url: SITE.url,
  telephone: SITE.telefono,
  image: imagen,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.direccion.calle,
    postalCode: SITE.direccion.cp,
    addressLocality: SITE.direccion.ciudad,
    addressRegion: SITE.direccion.provincia,
    addressCountry: "ES",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: SITE.geo.lat,
    longitude: SITE.geo.lng,
  },
  openingHoursSpecification: HORARIO_JSONLD,
  priceRange: "€€",
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f766e" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagen} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="bg-white font-sans text-slate-600 antialiased">
    <a href="#contenido" class="skip-link">Saltar al contenido principal</a>

    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
  </body>
</html>