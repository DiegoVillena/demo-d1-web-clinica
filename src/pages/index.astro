---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icono from "../components/Icono.astro";
import { SERVICIOS } from "../data/services";
import { SITE } from "../data/site";

import hero from "../assets/hero.jpg";

const confianza = [
  { dato: "+15 años", texto: "de experiencia en Albacete" },
  { dato: "+12.000", texto: "pacientes atendidos" },
  { dato: "3D", texto: "radiografía digital y estudio ortodoncia" },
];

const opiniones = [
  {
    nombre: "Carmen R.",
    tratamiento: "Endodoncia",
    hace: "hace 2 meses",
    texto:
      "Llevaba años sin venir por miedo. Me lo explicaron todo con el presupuesto por delante y sin agobios: dos muelas resueltas y una higiene impecable. Un encanto desde recepción.",
  },
  {
    nombre: "Luis M.",
    tratamiento: "Ortodoncia invisible",
    hace: "hace 3 meses",
    texto:
      "Estoy a mitad del plan de férulas y el seguimiento es de lujo: las citas van puntuales y siempre me resuelven por teléfono las dudas entre revisiones.",
  },
  {
    nombre: "Andrea P.",
    tratamiento: "Odontopediatría",
    hace: "hace 1 mes",
    texto:
      "Llevo a mis dos hijos desde los cuatro años. Se lo pasan bien (sí, en el dentista) y se van con su cepillo nuevo explicado. No puedo pedir más.",
  },
];
---

<BaseLayout
  title="Clínica Dental Serrano — Dentista en Albacete"
  description="Clínica dental de barrio en Albacete: higiene, empastes, ortodoncia invisible, implantes, endodoncia y odontopediatría. Citas sin esperas y presupuesto cerrado."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-teal-50 to-white">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:px-6 md:py-20 lg:grid-cols-2">
      <div>
        <p class="text-xs font-bold tracking-widest text-teal-700 uppercase">Clínica dental en Albacete</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Tu sonrisa merece un trato sin esperas
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed">
          Higiene, empastes, implantología y ortodoncia invisible en un gabinete moderno.
          Nos llamas, te vemos y sabes el presupuesto antes de empezar: así de claro.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="/contacto/" class="rounded-full bg-teal-700 px-7 py-3.5 text-base font-semibold text-white shadow-sm transition-colors hover:bg-teal-800">
            Pedir cita
          </a>
          <a href="/servicios/" class="rounded-full px-6 py-3.5 text-base font-semibold text-teal-800 transition-colors hover:bg-teal-50">
            Ver tratamientos →
          </a>
        </div>
        <p class="mt-6 text-sm text-slate-500">
          Respondemos en <strong class="text-slate-700">menos de 24 h</strong> laborables ·
          <a href={`tel:${SITE.telefonoHref}`} class="font-semibold text-teal-700 hover:text-teal-800">{SITE.telefono}</a>
        </p>
      </div>
      <div class="relative">
        <Image
          src={hero}
          alt="Dentista explorando los dientes de una paciente en el gabinete de la clínica"
          width={760}
          class="rounded-2xl object-cover shadow-lg ring-1 ring-slate-200"
          sizes="(min-width: 1024px) 50vw, 100vw"
          priority
        />
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <p class="text-xs font-bold tracking-widest text-teal-700 uppercase">Tratamientos</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Todo lo que tu boca necesita, en la misma clínica
        </h2>
        <p class="mt-4 text-lg">
          De la revisión de rutina al tratamiento completo de implantes. Sin derivarte:
          aquí tienes el problema y la solución.
        </p>
      </div>

      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          SERVICIOS.map((servicio) => (
            <li class="rounded-2xl bg-slate-50 p-6 ring-1 ring-slate-200">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-white text-teal-700 ring-1 ring-slate-200">
                <Icono nombre={servicio.icono} />
              </span>
              <h3 class="mt-4 text-lg font-semibold text-slate-900">{servicio.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed">{servicio.corto}</p>
              <a
                href={`/servicios/#${servicio.slug}`}
                class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-teal-700 hover:text-teal-800"
              >
                Saber más <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Franja de confianza -->
  <section class="bg-teal-800 text-white">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 text-center sm:grid-cols-3 sm:px-6">
      {
        confianza.map(({ dato, texto }) => (
          <div>
            <p class="text-4xl font-bold tracking-tight sm:text-5xl">{dato}</p>
            <p class="mt-2 text-sm text-teal-100">{texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Opiniones -->
  <section class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <p class="text-xs font-bold tracking-widest text-teal-700 uppercase">Opiniones</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Lo que cuentan nuestros pacientes
        </h2>
        <p class="mt-4 text-lg">
          Trato tranquilo, explicaciones claras y la boca resuelta. Esta es la combinación
          que repiten quienes vuelven.
        </p>
      </div>

      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {
          opiniones.map(({ nombre, tratamiento, hace, texto }) => (
            <li class="flex flex-col rounded-2xl bg-white p-6 ring-1 ring-slate-200">
              <p class="text-amber-400" aria-label="Cinco estrellas">
                ★★★★★
              </p>
              <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-slate-700">
                <p>«{texto}»</p>
              </blockquote>
              <p class="mt-4 text-sm">
                <span class="font-semibold text-slate-900">{nombre}</span> · {tratamiento}
                <span class="block text-xs text-slate-400">Reseña de ejemplo {hace}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CTA final -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="rounded-3xl bg-teal-700 px-6 py-12 text-center sm:px-16">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          ¿Cuándo fue tu última revisión?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-lg text-teal-50">
          La primera visita incluye revisión completa y diagnóstico con radiografía.
          La haces en 45 minutos y sales sabiendo qué hacer con tu boca.
        </p>
        <a
          href="/contacto/"
          class="mt-8 inline-flex rounded-full bg-white px-8 py-3.5 text-base font-semibold text-teal-800 shadow-sm transition-colors hover:bg-teal-50"
        >
          Pedir cita
        </a>
      </div>
    </div>
  </section>
</BaseLayout>